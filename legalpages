/* ═══════════════════════════════════════════════════════
   DIVINE PARTNERS — Legal Pages Shared CSS
   Applies to: disclaimer.html, disclosure.html,
               privacy-policy.html, sitemap.html
═══════════════════════════════════════════════════════ */

/* Inherit root variables from style.css */
@import url('style.css');

/* ─── LEGAL PAGE LAYOUT ─── */
.legal-page {
  min-height: 100vh;
  background: #F4F7F6;
  padding-top: calc(var(--nav-h) + var(--compliance-h) + 60px);
  padding-bottom: 80px;
}

.legal-container {
  max-width: 820px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ─── BREADCRUMB ─── */
.legal-breadcrumb {
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: var(--text-light);
  margin-bottom: 8px;
  letter-spacing: 0.04em;
}

.legal-breadcrumb a {
  color: var(--azure);
  text-decoration: none;
}

.legal-breadcrumb a:hover { text-decoration: underline; }

.legal-breadcrumb span { margin: 0 6px; opacity: 0.4; }

/* ─── PAGE HEADER ─── */
.legal-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--azure);
  margin-bottom: 12px;
}

.legal-tag::before {
  content: '';
  display: block;
  width: 16px;
  height: 1px;
  background: var(--green);
}

.legal-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 400;
  color: var(--navy);
  line-height: 1.15;
  margin-bottom: 8px;
}

.legal-updated {
  font-size: 0.8rem;
  color: var(--text-light);
  margin-bottom: 48px;
  padding-bottom: 24px;
  border-bottom: 1px solid #E0E8E4;
}

/* ─── CONTENT ─── */
.legal-body {
  background: #ffffff;
  border-radius: 16px;
  padding: 48px 52px;
  box-shadow: 0 4px 24px rgba(22,39,60,0.07);
  border: 1px solid #E0E8E4;
}

.legal-body h2 {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 500;
  color: var(--navy);
  margin: 36px 0 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #EDF2EF;
}

.legal-body h2:first-child { margin-top: 0; }

.legal-body p {
  font-size: 0.92rem;
  color: #3D5464;
  line-height: 1.85;
  margin-bottom: 16px;
}

.legal-body ul {
  margin: 12px 0 20px 0;
  padding-left: 0;
  list-style: none;
}

.legal-body ul li {
  font-size: 0.92rem;
  color: #3D5464;
  line-height: 1.75;
  padding: 4px 0 4px 20px;
  position: relative;
}

.legal-body ul li::before {
  content: '›';
  position: absolute;
  left: 0;
  color: var(--green);
  font-size: 1rem;
  font-weight: 700;
}

.legal-body strong {
  color: var(--navy);
  font-weight: 600;
}

.legal-body a {
  color: var(--azure);
  text-decoration: none;
  border-bottom: 1px solid rgba(27,134,201,0.3);
  transition: border-color 0.2s;
}

.legal-body a:hover { border-color: var(--azure); }

/* ─── TABLE (Disclosure registration details) ─── */
.legal-table {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0 28px;
  font-size: 0.88rem;
}

.legal-table tr {
  border-bottom: 1px solid #EDF2EF;
}

.legal-table td {
  padding: 12px 16px;
  vertical-align: top;
  line-height: 1.6;
}

.legal-table td:first-child {
  font-weight: 600;
  color: var(--navy);
  white-space: nowrap;
  width: 220px;
  background: #F8FAF9;
}

.legal-table td:last-child {
  color: #3D5464;
}

/* ─── HIGHLIGHT BOX ─── */
.legal-highlight {
  background: rgba(27,134,201,0.06);
  border-left: 3px solid var(--azure);
  border-radius: 0 8px 8px 0;
  padding: 16px 20px;
  margin: 20px 0;
  font-size: 0.88rem;
  color: var(--navy);
  line-height: 1.7;
}

/* ─── CONTACT BOX ─── */
.legal-contact-box {
  background: var(--navy);
  border-radius: 12px;
  padding: 28px 32px;
  margin-top: 36px;
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
}

.legal-contact-box h3 {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  color: var(--white);
  margin-bottom: 16px;
  font-weight: 400;
}

.legal-contact-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.legal-contact-item span {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.45);
}

.legal-contact-item a {
  font-size: 0.9rem;
  color: var(--gold-light);
  border-bottom: none;
}

.legal-contact-item a:hover { color: var(--green); }

/* ─── SITEMAP GRID ─── */
.sitemap-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
  margin-top: 8px;
}

.sitemap-section h3 {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--azure);
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid #E0E8E4;
}

.sitemap-section ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sitemap-section ul li {
  padding: 0;
  margin-bottom: 8px;
}

.sitemap-section ul li::before { display: none; }

.sitemap-section a {
  font-size: 0.88rem;
  color: var(--text-mid);
  text-decoration: none;
  border-bottom: none;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: color 0.2s;
}

.sitemap-section a::before {
  content: '→';
  font-size: 0.75rem;
  color: var(--green);
}

.sitemap-section a:hover { color: var(--azure); }

/* ─── RESPONSIVE ─── */
@media (max-width: 640px) {
  .legal-body { padding: 28px 20px; }
  .legal-table td:first-child { width: auto; white-space: normal; }
  .legal-contact-box { flex-direction: column; gap: 16px; }
  .sitemap-grid { grid-template-columns: 1fr; }
}
